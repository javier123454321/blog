<div class="not-prose bg-white border-4 border-black drop-shadow-hard">
  <div class="flex items-center justify-between gap-4 border-b-4 border-black px-4 py-2">
    <span class="text-sm font-semibold">{{ name | default: 'PDF' }}</span>
    <a class="text-sm font-semibold underline" href="{{ url }}" target="_blank" rel="noopener">Open PDF ↗</a>
  </div>
  <iframe src="{{ url }}" class="block w-full aspect-[3/4] bg-muted" loading="lazy"></iframe>
</div>
