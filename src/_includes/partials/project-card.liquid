<div
  x-data="{ display: false,
    date: '{{ project.date }}' }"
  x-init="setTimeout(() => display = true, 0)"
  x-cloak
  x-show="display"
  x-transition.delay.{{ index | times: 100 }}ms
  class="relative border-4 bg-purple-50 border-black drop-shadow-hard hover:drop-shadow-hard-sm hover:translate-y-1 hover:translate-x-1 transition-all"
>
  <a href="{{ project.filePathStem }}/" class="block">
    {%- if project.data.image and project.data.image != "/images/projects/.gitkeep" -%}
      <div class="border-b-4 border-black">
        <img src="{{ project.data.image }}" alt="{{ project.data.title }}" class="w-full h-40 object-cover" />
      </div>
    {%- endif -%}
    <div class="flex justify-between min-h-[72px]">
      <article class="max-w-screen text-xl px-4 font-black flex items-center flex-grow text-black">
        {{ project.data.title }}
      </article>
      <span
        class="flex items-center px-4 max-w-xs border-l-4 border-black"
        x-text="() => new Date(date).toLocaleDateString()"></span>
    </div>
    <div class="p-4 border-t-4 border-black">{{ project.data.desc }}</div>
  </a>
  {%- if project.data.url and project.data.url != "" -%}
    <a href="{{ project.data.url }}"
      target="_blank"
      rel="noopener"
      class="absolute top-2 right-2 inline-flex items-center justify-center w-8 h-8 rounded-full bg-black text-white font-black hover:bg-gray-800"
      aria-label="Open project externally"
      title="Open project externally">
      ↗
    </a>
  {%- endif -%}
  {%- if show_tags == true and project.data.topics -%}
    <ul class="flex items-center p-4 border-t-4 border-black">
      <span class="font-black mr-2">Topics:</span>
      {%- for tag in project.data.topics -%}
        <li class="mr-2">{{ tag }}</li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>